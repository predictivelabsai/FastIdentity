# ---- required in production -------------------------------------------------
SECRET_KEY=change-me-long-random            # session signing
IDENTITY_HASH_SECRET=change-me-long-random  # HMAC key for device/network/suppression hashes
ADMIN_EMAIL=admin@fastsme.com
ADMIN_PASSWORD=change-me
ADMIN_API_TOKEN=change-me-long-random       # bearer token for /v1/erasure and /v1/export
PUBLIC_BASE_URL=https://identity.fastsme.com
ALLOWED_ORIGINS=https://www.mymedicalgateway.com,https://mymedicalgateway.com

# ---- data layer ----------------------------------------------------------------
DB_SOURCE=sqlite                # sqlite | psql
DATABASE_PATH=data/fastidentity.db
# Used when DB_SOURCE=psql (FASTIDENTITY_DATABASE_URL, DATABASE_URL or DB_URL are all read)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SCHEMA=fast_identity
DEFAULT_TENANT=demo
FASTIDENTITY_PORT=5023

# ---- compliance --------------------------------------------------------------
DATA_REGION=uk
REQUIRE_ANALYTICS_CONSENT=true
EVENT_RETENTION_DAYS=395
ANON_PROFILE_RETENTION_DAYS=90

# ---- matching ----------------------------------------------------------------
MATCH_ENGINE=builtin            # builtin | splink (pip install -r requirements-splink.txt)
AUTO_MERGE_THRESHOLD=0.97
REVIEW_THRESHOLD=0.70
INTEREST_KEYS=treatment,hospital,category,product

# ---- activation (all optional; unset = dry-run log destination) -------------
DEFAULT_FREQUENCY_CAP=2
DEFAULT_FREQUENCY_WINDOW_DAYS=7
FLOW_WORKER_INTERVAL_SECONDS=60
KLAVIYO_API_KEY=
CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=
CUSTOMERIO_REGION=eu
BRAZE_API_KEY=
BRAZE_REST_ENDPOINT=https://rest.fra-02.braze.eu
WEBHOOK_DEFAULT_URL=
WEBHOOK_SIGNING_SECRET=

# --- Google SSO (optional; shared FastSME OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5023/auth/google/callback
# Unknown Google accounts are auto-provisioned as staff only if allow-listed.
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# --- SaaS / multi-tenancy ---
SIGNUP_OPEN=true                    # any Google account can create its own workspace
PLATFORM_ADMIN_EMAILS=              # FastSME staff: can open every workspace
PLATFORM_ADMIN_DOMAINS=

# Devices & households (households are opt-in per workspace in the UI)
HOUSEHOLD_WINDOW_DAYS=30
HOUSEHOLD_MIN_DAYS=2
HOUSEHOLD_MAX_MEMBERS=6
